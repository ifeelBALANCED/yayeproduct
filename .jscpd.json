{
  "$schema": "https://unpkg.com/jscpd@4.0.4/dist/schema.json",
  "minLines": 25,
  "threshold": 5,
  "reporters": ["console"],
  "languages": ["typescript", "tsx"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.d.ts",
    "**/supabase/**",
    "**/.omc/**"
  ],
  "absolute": false,
  "gitignore": true
}
